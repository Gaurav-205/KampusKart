# Frontend environment variables (all prefixed with VITE_ for Vite to expose them)

# API and WebSocket URLs
VITE_API_URL=http://localhost:5000
VITE_SOCKET_URL=http://localhost:5000

# Google sign-in button (off by default; the backend must also set GOOGLE_AUTH_ENABLED=true)
VITE_ENABLE_GOOGLE_AUTH=false

# Google Maps (required for campus map features)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
VITE_GOOGLE_MAPS_MAP_ID=your_google_maps_map_id
